# هذه القيم تُضاف في Render ← Environment (لا ترفع ملف .env للمستودع)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/clinicbot?retryWrites=true&w=majority
GEMINI_API_KEY=ضع_مفتاح_Gemini_الجديد_هنا
# محتوى credentials.json كاملاً في سطر واحد
GOOGLE_CREDENTIALS_JSON={"web":{...}}
# محتوى token.json كاملاً في سطر واحد (يُنشأ بأمر "ربط جوجل" في الواتساب)
GOOGLE_TOKEN_JSON={"access_token":"...","refresh_token":"..."}
